{
  "name": "evo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVO: Living World – Überlebensspiel über Evolution in einer gemeinsamen, lebendigen Welt (Phaser 4, TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "start": "node dist/server/server.mjs",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "spielabend": "vite build && node dist/server/server.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.41",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "colyseus": "^0.18.9",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
